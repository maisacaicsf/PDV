rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(lojaId) {
      return request.auth != null && get(/databases/$(database)/documents/lojas/$(lojaId)).data.donoUid == request.auth.uid;
    }
    function isAnonymous() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    match /lojas/{lojaId} {
      allow create: if request.auth != null && request.resource.data.donoUid == request.auth.uid;
      allow read, update: if isOwner(lojaId);
      allow delete: if false;

      match /usuarios/{uid} {
        allow create: if request.auth != null && uid == request.auth.uid && isOwner(lojaId);
        allow read, update: if request.auth != null && uid == request.auth.uid && isOwner(lojaId);
        allow delete: if false;
      }

      // Cadastro e consulta dos operadores.
      // O PDV usa autenticação anônima apenas para conseguir acessar o Firestore.
      // A conferência do código/senha é feita no documento do operador.
      match /operadores/{operadorId} {
        allow read: if isOwner(lojaId) || isAnonymous();
        allow create, update, delete: if isOwner(lojaId);
      }

      match /produtos/{produtoId} {
        allow read: if isOwner(lojaId) || isAnonymous();
        allow update: if isOwner(lojaId) || (isAnonymous() && request.resource.data.estoque <= resource.data.estoque && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estoque','atualizadoEm']));
        allow create, delete: if isOwner(lojaId);
      }

      match /vendas/{vendaId} {
        allow create: if isOwner(lojaId) || (isAnonymous() && request.resource.data.lojaId == lojaId);
        allow read: if isOwner(lojaId);
        allow update, delete: if isOwner(lojaId);
      }

      match /movimentacoes/{movimentoId} { allow read, write: if isOwner(lojaId); }
      match /chamados/{id} { allow read, write: if isOwner(lojaId); }
      match /solicitacoes/{id} { allow read, write: if isOwner(lojaId); }
    }
  }
}
